# CareerStack environment variables.
# Copy this file to .env.local and fill in real values there.
# NEVER commit .env.local or any real secrets.

# Public site URL (used for links, metadata, and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Chunk 4 — accounts & database; placeholders until the project exists)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
